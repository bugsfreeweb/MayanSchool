# Local preview: PostgreSQL. Do not commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Turso/libSQL takes precedence when its URL is configured.
# Use this backend for Vercel and for Cloudflare Workers (PostgreSQL is not
# reachable from the Workers runtime).
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required for public admin access. Without ADMIN_PASSWORD, Vercel/remote admin login is disabled.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# Optional: "static" only for a fully client-side build; leave unset for SSR.
# NEXT_PUBLIC_APP_ENV=server

