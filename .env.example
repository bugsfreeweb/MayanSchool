# Local preview: PostgreSQL. Do not commit real credentials.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Vercel deployment: Turso takes precedence when its URL is configured.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Required for public admin access. Without ADMIN_PASSWORD, Vercel admin login is disabled.
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
